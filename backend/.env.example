# Server Configuration
NODE_ENV=development
PORT=3001

# Database Configuration (Use either DATABASE_URL or individual settings)
DATABASE_URL=postgresql://username:password@host:port/database
# OR individual settings:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=safestories_db
DB_USER=your_username
DB_PASSWORD=your_password

# Email Configuration
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
# Legacy support (will be deprecated)
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password

# MinIO/S3 Configuration
MINIO_ENDPOINT=s3.fluidjobs.ai
MINIO_PORT=9002
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=your-secret-key
MINIO_BUCKET_NAME=safestories-panel

# Frontend URL (for CORS and email links)
FRONTEND_URL=https://safestories-app.onrender.com

# Legacy environment variables (for backward compatibility)
PGHOST=localhost
PGPORT=5432
PGDATABASE=safestories_db
PGUSER=your_username
PGPASSWORD=your_password